{
    "name": "jvancoillie/ldap-filter-lexer",
    "description": "Lexer, parser and builder for LDAP search filters (RFC 4515)",
    "type": "library",
    "keywords": ["ldap", "filter", "rfc4515", "lexer", "parser", "builder"],
    "authors": [
        {"name": "Jérémy Vancoillie"}
    ],
    "support": {
        "issues": "https://github.com/jvancoillie/LdapFilterLexer/issues",
        "source": "https://github.com/jvancoillie/LdapFilterLexer"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "2.1.x-dev"
        }
    },
    "require": {
        "php": ">=8.2",
        "doctrine/lexer": "^2.0 || ^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.5 || ^12.0",
        "vimeo/psalm": "^6.0",
        "friendsofphp/php-cs-fixer": "^3.64"
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Jvancoillie\\LdapFilterLexer\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Jvancoillie\\LdapFilterLexer\\Tests\\": "tests"
        }
    }
}
